[node name="GaucheHaut" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.8, 3.7, 0.3)
mesh = SubResource("Mesh_gauche_haut")

[node name="Sommet" type="MeshInstance3D" parent="."]

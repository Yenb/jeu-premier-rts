[gd_scene format=3]

[ext_resource type="Script" path="res://jeu/Outil de jeu/mother_cube.gd" id="1_mc"]
[ext_resource type="Shader" path="res://jeu/Outil de jeu/barre_de_vie.gdshader" id="2_shader"]

; -- MATERIAU MOTHER CUBE : violet emissif, distinct du bleu du generateur
; -- d'energie. Signale visuellement que c'est une entite differente,
; -- rare (une seule) et importante.
[sub_resource type="StandardMaterial3D" id="MatCoeur"]
albedo_color = Color(0.55, 0.2, 0.75, 1)
metallic = 0.6
roughness = 0.2
emission_enabled = true
emission = Color(0.7, 0.25, 0.95, 1)
emission_energy_multiplier = 2.0

[sub_resource type="BoxMesh" id="MeshCoeur"]
material = SubResource("MatCoeur")
size = Vector3(0.3, 0.3, 0.3)

[sub_resource type="BoxShape3D" id="ShapeMC"]
size = Vector3(0.3, 0.3, 0.3)

[sub_resource type="ShaderMaterial" id="MatBarre"]
shader = ExtResource("2_shader")
shader_parameter/couleur_vide = Color(0.15, 0.15, 0.15, 1)
shader_parameter/couleur_pleine = Color(0.15, 0.9, 0.2, 1)
shader_parameter/fraction = 1.0

[sub_resource type="QuadMesh" id="QuadBarre"]
material = SubResource("MatBarre")
size = Vector2(0.4, 0.06)

; -- RigidBody3D (physique amortie pour separation propre en cas
; -- d'imbrication) : mass 2 (petit cube), damping 2/2, lock_rotation
; -- garde la face vers le haut. Meme approche que generateur_energie.
[node name="MotherCube" type="RigidBody3D" groups=["destructible"]]
mass = 2.0
lock_rotation = true
linear_damp = 2.0
angular_damp = 2.0
script = ExtResource("1_mc")

[node name="Coeur" type="MeshInstance3D" parent="."]
mesh = SubResource("MeshCoeur")

[node name="Forme" type="CollisionShape3D" parent="."]
shape = SubResource("ShapeMC")

; -- BARRE DE VIE au-dessus, offset petit car cube 0.3m.
[node name="BarreDeVie" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.35, 0)

[node name="Barre" type="MeshInstance3D" parent="BarreDeVie"]
mesh = SubResource("QuadBarre")
